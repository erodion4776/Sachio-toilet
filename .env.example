# GEMINI_API_KEY: Not currently called anywhere in the app (leftover AI Studio
# scaffolding). Safe to leave as the placeholder unless you add an AI feature.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# SUPABASE_URL / SUPABASE_ANON_KEY: from Supabase project settings -> API.
# The anon key is safe to ship in the app; RLS policies enforce access control.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# PAYSTACK_PUBLIC_KEY: from Paystack dashboard -> Settings -> API Keys & Webhooks.
# Only the PUBLIC key belongs here. Never put the Paystack SECRET key in the
# app or in this file - it must live only on a backend server, since it can
# initiate charges and reveal transaction data if leaked.
PAYSTACK_PUBLIC_KEY=pk_test_YOUR_PAYSTACK_PUBLIC_KEY

# MAPS_API_KEY: Google Maps Platform API key (Maps SDK for Android + Places API
# enabled), restricted to this app's package name + SHA-1 in Google Cloud Console.
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
